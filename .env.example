# ===== LLM: DeepSeek V4 =====
# 官方入口 https://api.deepseek.com
# 2026-07-24 起 deepseek-chat 已停用，使用 deepseek-v4-flash（聊天）或 deepseek-v4-pro（推理）
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Vision LLM: 小米 MiMo-V2.5 =====
# 多模态模型，用于图片理解 + 结构化输出 + OCR
# 申请：https://platform.xiaomimimo.com
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_API_KEY=tp-your-mimo-key
MIMO_MODEL=mimo-v2.5

# ===== Embedding: 阿里云 DashScope =====
# 申请：https://bailian.console.aliyun.com → API-KEY
# 兼容 OpenAI 协议：POST {base}/embeddings
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ===== Reranker: Jina =====
JINA_API_BASE=https://api.jina.ai/v1
JINA_API_KEY=jina-your-jina-key
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# ===== 淘宝开放平台 =====
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION_KEY=
TAOBAO_WEBHOOK_SECRET=
TAOBAO_API_BASE=https://eco.taobao.com

# ===== 抖店开放平台（抖音电商）=====
# 申请：https://op.jinritemai.com/ → 创建应用 → 获取 AppKey/AppSecret
# 自用型应用可在后台获取 access_token；工具型应用需走 OAuth 授权流程
DOUDIAN_APP_KEY=
DOUDIAN_APP_SECRET=
DOUDIAN_SHOP_ID=
DOUDIAN_ACCESS_TOKEN=
DOUDIAN_WEBHOOK_SECRET=
DOUDIAN_API_BASE=https://openapi-fxg.jinritemai.com

# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 数据 =====
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma
